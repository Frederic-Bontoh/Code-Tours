        }
      },
      "title": "New Longest"
    },
    {
      "file": "Words/words.cpp",
      "description": "Once we have checked every word, we return whichever word is still in our `longest_word` variable.",
      "line": 19,
      "title": "Return Longest"
    },
    {
      "file": "Words/words.cpp",
      "description": "The next function counts how many vowels are in the word that is passed in.",
      "line": 22,
      "title": "countVowels"
    },
    {
